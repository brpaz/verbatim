<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0</metadata_license>
  <project_license>MIT</project_license>
  <name>Verbatim</name>
  <summary>Transcribe and caption speech on your computer</summary>
  <description>
    <p>Verbatim turns speech into text, from audio and video files or live from the microphone or system audio. Recognition runs on your computer, so audio never leaves it.</p>
    <ul>
      <li>Transcribes 25 European languages with Parakeet, or about 100 with Whisper</li>
      <li>Shows the transcript as it is recognised, and plays the file from any line</li>
      <li>Captions live audio from the microphone or from whatever the computer plays</li>
      <li>Saves the transcript as text, or as SRT or WebVTT subtitles</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/brpaz/verbatim/main/data/resources/screenshots/screenshot1.png</image>
      <caption>A transcript, played back from the selected line</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/brpaz/verbatim</url>
  <url type="bugtracker">https://github.com/brpaz/verbatim/issues</url>
  <url type="vcs-browser">https://github.com/brpaz/verbatim</url>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.0" date="2019-07-11" />
  </releases>
  <developer>
    <id>bruno_paz</id>
    <name translate="no">Bruno Paz</name>
  </developer>
  <!--
    Branding colors:
    https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines/#brand-color
  -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>
  <update_contact>noreply@example.com</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
</component>
