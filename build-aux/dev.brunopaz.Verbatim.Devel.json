{
    "id": "dev.brunopaz.Verbatim.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "verbatim",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--env=RUST_LOG=debug",
        "--env=G_MESSAGES_DEBUG=none",
        "--env=RUST_BACKTRACE=1"
    ],
    "command": "verbatim",
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
        "env": {
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER": "clang",
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS": "-C link-arg=-fuse-ld=/usr/lib/sdk/rust-stable/bin/mold",
            "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER": "clang",
            "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS": "-C link-arg=-fuse-ld=/usr/lib/sdk/rust-stable/bin/mold"
        },
        "test-args": ["--socket=x11"]
    },
    "modules": [
        {
            "name": "blueprint-compiler",
            "buildsystem": "meson",
            "cleanup": ["*"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/blueprint-compiler",
                    "tag": "v0.22.2"
                }
            ]
        },
        {
            "name": "verbatim",
            "buildsystem": "meson",
            "run-tests": true,
            "build-options": {
                "env": {
                    "CARGO_NET_OFFLINE": "true",
                    "SHERPA_ONNX_ARCHIVE_DIR": "/run/build/verbatim/sherpa-onnx"
                }
            },
            "config-opts": ["-Dprofile=development"],
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                },
                "cargo-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir -p .cargo",
                        "cp cargo/config .cargo/config.toml"
                    ]
                },
                {
                    "type": "file",
                    "url": "https://github.com/k2-fsa/sherpa-onnx/releases/download/v1.13.8/sherpa-onnx-v1.13.8-linux-x64-static-lib.tar.bz2",
                    "sha256": "e1fdc5b67530e15741ef897fa5ffff297056f3bf0c6d829a27af9225a4c4b5a6",
                    "dest": "sherpa-onnx",
                    "only-arches": ["x86_64"]
                },
                {
                    "type": "file",
                    "url": "https://github.com/k2-fsa/sherpa-onnx/releases/download/v1.13.8/sherpa-onnx-v1.13.8-linux-aarch64-static-lib.tar.bz2",
                    "sha256": "77983e3cf29aa60f2e531d249dbd01d15596530550c8db2e9e02fc6a655da6bb",
                    "dest": "sherpa-onnx",
                    "only-arches": ["aarch64"]
                }
            ]
        }
    ]
}
